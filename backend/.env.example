# 后端配置模板：复制为 backend/.env 后填写；不要提交真实密钥。
# 由 Pydantic Settings 加载；API 和独立 AI Worker 共用此文件。
# 根目录 .env 仅供 Docker Compose 使用，不会自动同步到本文件。

# ---------- 应用与本地联调 ----------
# development 默认开启 FastAPI debug 和自动重载；test/production 默认关闭。
# --reload / --no-reload 可覆盖自动重载，debug 始终由 APP_ENV 决定。
APP_ENV=development
LOG_LEVEL=INFO
# 业务日期固定按 UTC+8 计算；操作时间仍以 UTC 保存。
BUSINESS_TIMEZONE=Asia/Shanghai
# JSON 数组，仅供 H5 开发预览；生产环境改成实际允许的来源。
CORS_ORIGINS=["http://127.0.0.1:10086","http://localhost:10086"]

# ---------- 数据库与 Redis：与根目录 Compose 默认值一致 ----------
# Python 在宿主机运行，因此使用 127.0.0.1 和映射端口。
# 如果修改 Compose 的数据库、用户、密码或端口，请同步修改这里。
# 连接 URL 中的密码如含特殊字符，需要进行 URL 编码。
DATABASE_URL=postgresql+psycopg://cost_tracking:cost_tracking_local@127.0.0.1:25473/cost_tracking
REDIS_URL=redis://127.0.0.1:26381/0

# ---------- 登录会话 ----------
# 必填：生成随机密钥，例如 python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
# 以下有效期为开发建议值，生产会话策略上线前确认。
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 仅 development/test 环境允许启用；生产配置必须关闭且由代码强制检查。
DEV_AUTH_ENABLED=true

# ---------- 微信小程序：真实微信登录时必填 ----------
# 与前端小程序使用同一 AppID；AppSecret 仅保存在后端。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---------- 文件存储：腾讯云 COS，阶段 A 上传功能必填 ----------
STORAGE_PROVIDER=cos
# 使用目标 Bucket 的受限 CAM 凭证，Bucket 设为私有读写。
# 客户端直传；后端需要 HEAD、GET 签名、PUT/内部复制权限及 imageInfo 元数据校验能力。
# Bucket 需支持数据万象 imageInfo；H5 直传需配置 Bucket CORS。
COS_SECRET_ID=
COS_SECRET_KEY=
# 临时凭证的 SessionToken；使用长期凭证时留空。
COS_SESSION_TOKEN=
# 地域示例 ap-guangzhou；填写 Bucket 实际所在地域。
COS_REGION=
# 完整 Bucket 名称，包含 APPID 后缀，例如 cost-tracking-dev-1250000000。
COS_BUCKET=
# 对象键前缀；生产环境建议使用独立 Bucket 和凭证。
COS_KEY_PREFIX=cost-tracking/development/
COS_SCHEME=https
# 以下为本地开发建议值，生产文件限制与访问有效期仍需确认。
# 已签发 URL 在有效期内可能继续有效；需要即时撤权时使用鉴权代理。
COS_SIGNED_URL_TTL_SECONDS=300
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp"]

# ---------- AI 截图识别：DeepSeek 图片输入 ----------
# 使用识别时设为 true，并在独立终端运行 uv run python -m app.worker。
# 不使用 AI 时可以关闭，普通物品功能不受影响。
AI_ENABLED=false
# API 启动时同时运行识别队列；仅在独立部署 Worker 时设为 false。
AI_WORKER_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# 开启思考；输出 token 上限留空时，请求不发送 max_tokens，使用供应商默认额度。
# 供应商默认额度仍受模型上限约束，不代表无限输出。
AI_THINKING_ENABLED=true
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_SECONDS=180
AI_MAX_CONCURRENCY=2
# 每个 Worker 的并行数由 AI_MAX_CONCURRENCY 控制。任务队列持久化在 PostgreSQL，
# 领取、状态和草稿在同一数据库中，无需额外启动 Celery/Redis 队列。
# 以下为开发默认限制，上线前可按实际政策调整。
AI_IMPORT_MAX_SOURCES=9
AI_IMPORT_MAX_ACTIVE_SOURCES=18

# 小程序码目标版本：release（正式版）、trial（体验版）、develop（开发版）
WECHAT_CODE_ENV_VERSION=release
